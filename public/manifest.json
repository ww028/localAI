{
  "manifest_version": 3,
  "name": "localAI",
  "description": "Chrome Built-in AI playground for browser-local model experiments.",
  "version": "0.1.0",
  "action": {
    "default_title": "localAI",
    "default_popup": "index.html"
  },
  "side_panel": {
    "default_path": "index.html?surface=sidepanel"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "offscreen",
    "windows",
    "tabs",
    "scripting",
    "activeTab"
  ],
  "minimum_chrome_version": "138"
}
