{
  "name": "local-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Chrome extension playground for Chrome Built-in AI APIs.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "build:extension": "npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:prompt": "node --test tests/assistantPrompt.test.mjs",
    "test:intent": "node --test tests/assistantIntent.test.mjs",
    "test:planner": "node --test tests/assistantPlanner.test.mjs",
    "test:executor": "node --test tests/assistantDeterministicExecutor.test.mjs",
    "eval": "node scripts/run-evals.mjs"
  },
  "keywords": [
    "chrome",
    "built-in-ai",
    "gemini-nano",
    "local-ai",
    "prompt-api"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
